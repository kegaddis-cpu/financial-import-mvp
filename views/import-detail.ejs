<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Import <%= imp.id %></title>
  <style>
    body {
      font-family: Arial, sans-serif;
      margin: 2rem;
      color: #1f2937;
      background: #ffffff;
    }

    h1, h2 {
      margin-bottom: 0.5rem;
    }

    p {
      color: #4b5563;
    }

    .top-links {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
      margin-bottom: 1rem;
    }

    a {
      color: #2563eb;
      text-decoration: none;
    }

    .meta, .summary-grid, .panel {
      margin-bottom: 1.5rem;
    }

    .summary-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
      gap: 1rem;
    }

    .card, .panel {
      border: 1px solid #e5e7eb;
      border-radius: 10px;
      padding: 1rem;
      background: #fff;
    }

    .card strong {
      display: block;
      font-size: 1.4rem;
      color: #111827;
      margin-bottom: 0.25rem;
    }

    .muted {
      color: #6b7280;
    }

    .scroll {
      overflow-x: auto;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 0.75rem;
      min-width: 700px;
    }

    th, td {
      border: 1px solid #e5e7eb;
      padding: 0.7rem;
      text-align: left;
      vertical-align: top;
    }

    th {
      background: #f3f4f6;
    }

    td.num, th.num {
      text-align: right;
      white-space: nowrap;
    }

    .issue-badge {
      display: inline-block;
      padding: 0.2rem 0.5rem;
      border-radius: 999px;
      background: #fef3c7;
      color: #92400e;
      font-size: 0.85rem;
      white-space: nowrap;
    }

    .ok-empty {
      color: #6b7280;
      padding: 0.25rem 0 0;
    }

    .amount-negative {
      color: #b91c1c;
      font-weight: 600;
    }

    .amount-positive {
      color: #047857;
      font-weight: 600;
    }
  </style>
</head>
<body>
  <div class="top-links">
    <a href="/">← Back to dashboard</a>
    <a href="/data/imports">Import history</a>
    <a href="/expenses/new">Add expense</a>
    <a href="/sales/new">Record sale</a>
  </div>

  <h1>Import #<%= imp.id %></h1>

  <div class="meta">
    <p>
      <strong><%= imp.filename %></strong><br />
      Imported: <%= imp.imported_at %><br />
      Parsed rows: <%= imp.row_count %>
    </p>
  </div>

  <div class="summary-grid">
    <div class="card">
      <strong><%= accounts ? accounts.length : 0 %></strong>
      <span>Account snapshots</span>
    </div>
    <div class="card">
      <strong><%= properties ? properties.length : 0 %></strong>
      <span>Properties with transactions</span>
    </div>
    <div class="card">
      <strong><%= propertyValues ? propertyValues.length : 0 %></strong>
      <span>Property values</span>
    </div>
    <div class="card">
      <strong><%= issues ? issues.length : 0 %></strong>
      <span>Visible issues</span>
    </div>
  </div>

  <div class="panel">
    <h2>Property rollup</h2>

    <% if (properties && properties.length) { %>
      <div class="scroll">
        <table>
          <thead>
            <tr>
              <th>Property</th>
              <th class="num">Transactions</th>
              <th class="num">Income</th>
              <th class="num">Expenses</th>
              <th class="num">Net</th>
            </tr>
          </thead>
          <tbody>
            <% properties.forEach(function(row) { %>
              <tr>
                <td><%= row.property_name || '' %></td>
                <td class="num"><%= row.txn_count ?? '' %></td>
                <td class="num amount-positive">
                  <%= row.income_total == null
                    ? ''
                    : Number(row.income_total).toLocaleString('en-US', { style: 'currency', currency: 'USD' }) %>
                </td>
                <td class="num amount-negative">
                  <%= row.expense_total == null
                    ? ''
                    : Number(row.expense_total).toLocaleString('en-US', { style: 'currency', currency: 'USD' }) %>
                </td>
                <td class="num <%= Number(row.net_total || 0) < 0 ? 'amount-negative' : 'amount-positive' %>">
                  <%= row.net_total == null
                    ? ''
                    : Number(row.net_total).toLocaleString('en-US', { style: 'currency', currency: 'USD' }) %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <p class="ok-empty">No property rollup available.</p>
    <% } %>
  </div>

  <div class="panel">
    <h2>Account snapshots</h2>

    <% if (accounts && accounts.length) { %>
      <div class="scroll">
        <table>
          <thead>
            <tr>
              <th>Account</th>
              <th class="num">Balance</th>
              <th>As of</th>
            </tr>
          </thead>
          <tbody>
            <% accounts.forEach(function(row) { %>
              <tr>
                <td><%= row.account_name || row.name || '' %></td>
                <td class="num">
                  <%= row.balance == null
                    ? ''
                    : Number(row.balance).toLocaleString('en-US', { style: 'currency', currency: 'USD' }) %>
                </td>
                <td><%= row.as_of || row.snapshot_date || '' %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <p class="ok-empty">No account snapshots available.</p>
    <% } %>
  </div>

  <div class="panel">
    <h2>Property values</h2>

    <% if (propertyValues && propertyValues.length) { %>
      <div class="scroll">
        <table>
          <thead>
            <tr>
              <th>Property</th>
              <th class="num">Value</th>
              <th>As of</th>
            </tr>
          </thead>
          <tbody>
            <% propertyValues.forEach(function(row) { %>
              <tr>
                <td><%= row.property_name || '' %></td>
                <td class="num">
                  <%= row.property_value == null && row.value == null
                    ? ''
                    : Number(row.property_value ?? row.value).toLocaleString('en-US', { style: 'currency', currency: 'USD' }) %>
                </td>
                <td><%= row.as_of || row.valuation_date || '' %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <p class="ok-empty">No property values available.</p>
    <% } %>
  </div>

  <div class="panel">
    <h2>Issues</h2>

    <% if (issues && issues.length) { %>
      <div class="scroll">
        <table>
          <thead>
            <tr>
              <th>Type</th>
              <th>Message</th>
              <th>Row</th>
            </tr>
          </thead>
          <tbody>
            <% issues.forEach(function(row) { %>
              <tr>
                <td><span class="issue-badge"><%= row.issue_type || row.type || 'Issue' %></span></td>
                <td><%= row.message || row.issue_message || '' %></td>
                <td><%= row.row_number ?? row.source_row ?? '' %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <p class="ok-empty">No issues detected.</p>
    <% } %>
  </div>
</body>
</html>