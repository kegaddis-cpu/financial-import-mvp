<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Import <%= importId %></title>
    <style>
      body {
        font-family: Arial, sans-serif;
        max-width: 960px;
        margin: 40px auto;
        padding: 0 16px;
        color: #222;
      }

      h1,
      h2 {
        margin-bottom: 8px;
      }

      .card {
        border: 1px solid #ddd;
        border-radius: 10px;
        padding: 20px;
        margin: 20px 0;
      }

      .back-link {
        color: #111;
        text-decoration: none;
      }

      .stats {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 12px;
        margin-top: 16px;
      }

      .stat {
        background: #f7f7f7;
        border-radius: 8px;
        padding: 14px;
      }

      .label {
        color: #666;
        font-size: 13px;
      }

      .value {
        font-size: 24px;
        font-weight: 700;
        margin-top: 4px;
      }

      table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 12px;
      }

      th,
      td {
        border: 1px solid #ddd;
        padding: 10px;
        text-align: left;
        vertical-align: top;
      }

      th {
        background: #f3f3f3;
      }

      .muted {
        color: #666;
      }
    </style>
  </head>
  <body>
    <p>
      <a class="back-link" href="/data/imports">← Back to imports</a>
    </p>

    <h1>Import #<%= importId %></h1>

    <div class="card">
      <p><strong>File:</strong> <%= importRecord.filename %></p>
      <p><strong>Imported at:</strong> <%= importRecord.imported_at %></p>
      <p><strong>Rows imported:</strong> <%= importRecord.row_count ?? 0 %></p>
      <p><strong>Sheets:</strong> <%= importRecord.sheet_count ?? 0 %></p>

      <% if (importRecord.notes) { %>
        <p><strong>Notes:</strong> <%= importRecord.notes %></p>
      <% } %>

      <div class="stats">
        <div class="stat">
          <div class="label">Transactions</div>
          <div class="value"><%= counts.transactions %></div>
        </div>

        <div class="stat">
          <div class="label">Accounts</div>
          <div class="value"><%= counts.accounts %></div>
        </div>

        <div class="stat">
          <div class="label">Property values</div>
          <div class="value"><%= counts.property_values %></div>
        </div>

        <div class="stat">
          <div class="label">Issues</div>
          <div class="value"><%= counts.issues %></div>
        </div>
      </div>
    </div>

    <div class="card">
      <h2>Import issues</h2>

      <% if (issues && issues.length) { %>
        <table>
          <thead>
            <tr>
              <th>Type</th>
              <th>Message</th>
              <th>Row</th>
            </tr>
          </thead>
          <tbody>
            <% issues.forEach(function(issue) { %>
              <tr>
                <td><%= issue.issue_type %></td>
                <td><%= issue.message %></td>
                <td><%= issue.row_number ?? '' %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } else { %>
        <p class="muted">No issues were recorded for this import.</p>
      <% } %>
    </div>
  </body>
</html>
