<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Import <%= imp.id %> · Financial workbook importer</title>
  <style>
    :root {
      --bg: #f7f8fb;
      --panel: #ffffff;
      --text: #182132;
      --muted: #657089;
      --border: #dfe4ee;
      --primary: #0f62fe;
      --primary-dark: #0b4fd1;
      --success: #16794b;
      --warning: #b26a00;
      --danger: #c52828;
      --danger-bg: #fff1f1;
      --warning-bg: #fff7e8;
      --success-bg: #eefbf3;
      --shadow: 0 10px 28px rgba(15, 23, 42, 0.08);
      --radius: 14px;
    }

    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: Inter, Arial, sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.45;
    }

    a {
      color: var(--primary);
      text-decoration: none;
    }

    a:hover { text-decoration: underline; }

    .wrap {
      max-width: 1240px;
      margin: 0 auto;
      padding: 24px;
    }

    .topbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 16px;
      margin-bottom: 24px;
      flex-wrap: wrap;
    }

    h1, h2, h3 {
      margin: 0 0 10px;
    }

    .subtle {
      color: var(--muted);
      font-size: 14px;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 16px;
      margin-bottom: 24px;
    }

    .card {
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      padding: 18px;
      margin-bottom: 20px;
    }

    .stat {
      min-height: 108px;
    }

    .stat .label {
      color: var(--muted);
      font-size: 13px;
      margin-bottom: 8px;
    }

    .stat .value {
      font-size: 30px;
      font-weight: 700;
      margin-bottom: 6px;
    }

    .warning {
      border: 1px solid #f1d49b;
      background: var(--warning-bg);
      color: #6f4b00;
      padding: 14px 16px;
      border-radius: 12px;
      margin-bottom: 20px;
    }

    .danger {
      border: 1px solid #f0b8b8;
      background: var(--danger-bg);
      color: #872424;
      padding: 14px 16px;
      border-radius: 12px;
      margin-bottom: 20px;
    }

    .success {
      border: 1px solid #b9e7cb;
      background: var(--success-bg);
      color: #155f3d;
      padding: 14px 16px;
      border-radius: 12px;
      margin-bottom: 20px;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      background: #fff;
    }

    th, td {
      padding: 12px 10px;
      border-bottom: 1px solid var(--border);
      vertical-align: top;
      text-align: left;
      font-size: 14px;
    }

    th {
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: var(--muted);
      background: #fafbfe;
    }

    .mono {
      font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      font-size: 12px;
      white-space: pre-wrap;
      word-break: break-word;
    }

    .pill {
      display: inline-block;
      border-radius: 999px;
      padding: 4px 10px;
      font-size: 12px;
      font-weight: 600;
      border: 1px solid transparent;
    }

    .pill-open {
      background: #fff4e5;
      color: #8a5500;
      border-color: #f1d49b;
    }

    .pill-resolved {
      background: #eefbf3;
      color: #155f3d;
      border-color: #b9e7cb;
    }

    .pill-ignored {
      background: #f2f4f8;
      color: #596579;
      border-color: #d9dfe8;
    }

    .actions {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      align-items: center;
    }

    input[type="text"],
    input[type="number"],
    select,
    textarea {
      width: 100%;
      border: 1px solid #cfd7e6;
      border-radius: 10px;
      padding: 10px 12px;
      font: inherit;
      background: #fff;
    }

    textarea {
      min-height: 82px;
      resize: vertical;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border: 1px solid transparent;
      border-radius: 10px;
      padding: 10px 14px;
      font: inherit;
      font-weight: 600;
      cursor: pointer;
      text-decoration: none;
    }

    .btn-primary {
      background: var(--primary);
      color: #fff;
    }

    .btn-primary:hover {
      background: var(--primary-dark);
      text-decoration: none;
    }

    .btn-secondary {
      background: #fff;
      color: var(--text);
      border-color: var(--border);
    }

    .btn-danger {
      background: #fff;
      color: var(--danger);
      border-color: #efb2b2;
    }

    .issue-grid {
      display: grid;
      grid-template-columns: 1.3fr 1fr;
      gap: 16px;
      margin-top: 12px;
    }

    .issue-box {
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 14px;
      background: #fcfdff;
    }

    .section-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: 12px;
      flex-wrap: wrap;
    }

    .empty {
      color: var(--muted);
      padding: 8px 0 2px;
    }

    .two-col {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
    }

    .small {
      font-size: 12px;
      color: var(--muted);
    }

    .mb0 { margin-bottom: 0; }

    @media (max-width: 1024px) {
      .grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
      .issue-grid,
      .two-col {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 640px) {
      .wrap {
        padding: 16px;
      }
      .grid {
        grid-template-columns: 1fr;
      }
      th, td {
        font-size: 13px;
        padding: 10px 8px;
      }
      .stat .value {
        font-size: 26px;
      }
    }
  </style>
</head>
<body>
  <div class="wrap">
    <div class="topbar">
      <div>
        <div class="subtle"><a href="/">← Back to dashboard</a></div>
        <h1>Import #<%= imp.id %></h1>
        <div class="subtle">
          <strong><%= imp.filename %></strong> · Imported <%= imp.imported_at %> · <%= imp.row_count %> parsed rows
        </div>
      </div>
      <div class="actions">
        <a class="btn btn-secondary" href="/">Home</a>
      </div>
    </div>

    <%
      const openIssues = (issues || []).filter(i => (i.status || 'open') === 'open');
      const resolvedIssues = (issues || []).filter(i => i.status === 'resolved');
      const ignoredIssues = (issues || []).filter(i => i.status === 'ignored');
      const accountCount = (accounts || []).length;
      const propertyCount = (properties || []).length;
      const propertyValueCount = (propertyValues || []).length;
    %>

    <% if (openIssues.length > 0) { %>
      <div class="warning">
        This import has <strong><%= openIssues.length %></strong> open issue<%= openIssues.length === 1 ? '' : 's' %>. Review and repair them below before treating this import as final.
      </div>
    <% } else { %>
      <div class="success">
        This import currently has no open issues.
      </div>
    <% } %>

    <div class="grid">
      <div class="card stat">
        <div class="label">Accounts</div>
        <div class="value"><%= accountCount %></div>
        <div class="subtle">Parsed from account snapshots</div>
      </div>
      <div class="card stat">
        <div class="label">Property summaries</div>
        <div class="value"><%= propertyCount %></div>
        <div class="subtle">Distinct properties with transactions</div>
      </div>
      <div class="card stat">
        <div class="label">Property values</div>
        <div class="value"><%= propertyValueCount %></div>
        <div class="subtle">Rows imported from Property Values</div>
      </div>
      <div class="card stat">
        <div class="label">Open issues</div>
        <div class="value"><%= openIssues.length %></div>
        <div class="subtle">Needs review</div>
      </div>
      <div class="card stat">
        <div class="label">Resolved / ignored</div>
        <div class="value"><%= resolvedIssues.length + ignoredIssues.length %></div>
        <div class="subtle">Historical issue actions</div>
      </div>
    </div>

    <div class="card">
      <div class="section-head">
        <div>
          <h2>Property totals</h2>
          <div class="subtle">Calculated from imported transactions</div>
        </div>
      </div>

      <% if (!properties || properties.length === 0) { %>
        <div class="empty">No property transaction totals were generated for this import.</div>
      <% } else { %>
        <table>
          <thead>
            <tr>
              <th>Property</th>
              <th>Transactions</th>
              <th>Income</th>
              <th>Expenses</th>
              <th>Net</th>
            </tr>
          </thead>
          <tbody>
            <% properties.forEach(function(row) { %>
              <tr>
                <td><%= row.property_name || '—' %></td>
                <td><%= row.txn_count %></td>
                <td><%= formatCurrency(row.income_total) %></td>
                <td><%= formatCurrency(row.expense_total) %></td>
                <td><%= formatCurrency(row.net_total) %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>

    <div class="two-col">
      <div class="card">
        <div class="section-head">
          <div>
            <h2>Accounts</h2>
            <div class="subtle">Imported account snapshot rows</div>
          </div>
        </div>

        <% if (!accounts || accounts.length === 0) { %>
          <div class="danger">
            No accounts were imported for this file. If transactions were imported, this usually means the workbook’s Accounts sheet was missing, misnamed, or structurally inconsistent.
          </div>
        <% } else { %>
          <table>
            <thead>
              <tr>
                <th>Date</th>
                <th>Bank</th>
                <th>Type</th>
                <th>Balance</th>
              </tr>
            </thead>
            <tbody>
              <% accounts.forEach(function(row) { %>
                <tr>
                  <td><%= row.snapshot_date || '—' %></td>
                  <td><%= row.bank || '—' %></td>
                  <td><%= row.account_type || '—' %></td>
                  <td><%= formatCurrency(row.balance) %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } %>
      </div>

      <div class="card">
        <div class="section-head">
          <div>
            <h2>Property values</h2>
            <div class="subtle">Imported valuation rows</div>
          </div>
        </div>

        <% if (!propertyValues || propertyValues.length === 0) { %>
          <div class="empty">No property valuation rows were imported.</div>
        <% } else { %>
          <table>
            <thead>
              <tr>
                <th>Address</th>
                <th>Purchased</th>
                <th>Estimate</th>
                <th>Snapshot</th>
              </tr>
            </thead>
            <tbody>
              <% propertyValues.forEach(function(row) { %>
                <tr>
                  <td><%= row.address || '—' %></td>
                  <td><%= formatCurrency(row.purchased) %></td>
                  <td><%= formatCurrency(row.estimate) %></td>
                  <td><%= row.snapshot_date || '—' %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } %>
      </div>
    </div>

    <div class="card">
      <div class="section-head">
        <div>
          <h2>Import issues</h2>
          <div class="subtle">Open issues can be repaired or ignored directly from this page</div>
        </div>
      </div>

      <% if (!issues || issues.length === 0) { %>
        <div class="empty">No issues were recorded for this import.</div>
      <% } else { %>
        <% issues.forEach(function(issue) { %>
          <%
            const payload = issue.raw_payload ? JSON.parse(issue.raw_payload) : {};
            const status = issue.status || 'open';
          %>

          <div class="issue-box" style="margin-bottom: 16px;">
            <div class="section-head">
              <div>
                <h3 class="mb0"><%= issue.issue_type %></h3>
                <div class="small">
                  Sheet: <%= issue.sheet_name || '—' %>
                  <% if (issue.row_number) { %> · Row: <%= issue.row_number %><% } %>
                </div>
              </div>
              <div>
                <% if (status === 'open') { %>
                  <span class="pill pill-open">Open</span>
                <% } else if (status === 'resolved') { %>
                  <span class="pill pill-resolved">Resolved</span>
                <% } else { %>
                  <span class="pill pill-ignored">Ignored</span>
                <% } %>
              </div>
            </div>

            <p><%= issue.message || 'No message provided.' %></p>

            <div class="issue-grid">
              <div>
                <div class="small" style="margin-bottom: 6px;">Raw row payload</div>
                <div class="mono"><%= JSON.stringify(payload, null, 2) %></div>
              </div>

              <div>
                <% if (status === 'open') { %>
                  <% if (issue.issue_type === 'invalid_transaction_amount') { %>
                    <form method="POST" action="/imports/<%= imp.id %>/issues/<%= issue.id %>/resolve" style="margin-bottom: 12px;">
                      <div class="small" style="margin-bottom: 6px;">Repair amount</div>
                      <div style="margin-bottom: 10px;">
                        <label class="small">Corrected amount</label>
                        <input type="number" step="0.01" name="corrected_amount" placeholder="0.00" required />
                      </div>
                      <div style="margin-bottom: 10px;">
                        <label class="small">Map property (optional)</label>
                        <select name="mapped_property">
                          <option value="">No property</option>
                          <% propertyOptions.forEach(function(option) { %>
                            <option value="<%= option %>"><%= option %></option>
                          <% }) %>
                        </select>
                      </div>
                      <button class="btn btn-primary" type="submit">Resolve issue</button>
                    </form>
                  <% } else if (issue.issue_type === 'unmatched_property_name') { %>
                    <form method="POST" action="/imports/<%= imp.id %>/issues/<%= issue.id %>/resolve" style="margin-bottom: 12px;">
                      <div class="small" style="margin-bottom: 6px;">Map to a known property</div>
                      <div style="margin-bottom: 10px;">
                        <label class="small">Property</label>
                        <select name="mapped_property" required>
                          <option value="">Select property</option>
                          <% propertyOptions.forEach(function(option) { %>
                            <option value="<%= option %>"><%= option %></option>
                          <% }) %>
                        </select>
                      </div>
                      <button class="btn btn-primary" type="submit">Map property</button>
                    </form>
                  <% } else { %>
                    <div class="small" style="margin-bottom: 10px;">
                      No custom repair form exists yet for this issue type.
                    </div>
                  <% } %>

                  <form method="POST" action="/imports/<%= imp.id %>/issues/<%= issue.id %>/ignore">
                    <div style="margin-bottom: 10px;">
                      <label class="small">Ignore reason (optional)</label>
                      <textarea name="reason" placeholder="Why this issue is safe to ignore"></textarea>
                    </div>
                    <button class="btn btn-danger" type="submit">Ignore issue</button>
                  </form>
                <% } else { %>
                  <div class="small">Resolution type</div>
                  <div style="margin-bottom: 8px;"><%= issue.resolution_type || '—' %></div>

                  <div class="small">Resolved at</div>
                  <div style="margin-bottom: 8px;"><%= issue.resolved_at || '—' %></div>

                  <div class="small">Resolution payload</div>
                  <div class="mono"><%= issue.resolution_payload || '—' %></div>
                <% } %>
              </div>
            </div>
          </div>
        <% }) %>
      <% } %>
    </div>
  </div>
</body>
</html>
