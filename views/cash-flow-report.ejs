<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Monthly Cash-Flow by Property</title>
  <style>
    :root {
      color-scheme: light dark;
      --bg: #f7f7fb;
      --card: #ffffff;
      --text: #1f2937;
      --muted: #6b7280;
      --border: #d1d5db;
      --accent: #0f766e;
      --accent-dark: #115e59;
      --income: #166534;
      --expense: #b91c1c;
      --net: #1d4ed8;
      --shadow: 0 10px 30px rgba(15, 23, 42, 0.08);
    }

    @media (prefers-color-scheme: dark) {
      :root {
        --bg: #0f172a;
        --card: #111827;
        --text: #e5e7eb;
        --muted: #9ca3af;
        --border: #374151;
        --accent: #14b8a6;
        --accent-dark: #0f766e;
        --income: #4ade80;
        --expense: #f87171;
        --net: #60a5fa;
        --shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
      }
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.4;
    }

    .page {
      max-width: 1200px;
      margin: 0 auto;
      padding: 24px;
    }

    .topbar {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: 12px;
      align-items: center;
      margin-bottom: 20px;
    }

    .topbar a {
      color: var(--accent);
      text-decoration: none;
      font-weight: 600;
    }

    .title-wrap h1 {
      margin: 0 0 6px;
      font-size: 2rem;
    }

    .title-wrap p {
      margin: 0;
      color: var(--muted);
    }

    .card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 14px;
      box-shadow: var(--shadow);
      padding: 18px;
      margin-bottom: 20px;
    }

    form.filters {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      align-items: end;
    }

    .field {
      display: flex;
      flex-direction: column;
      gap: 6px;
      min-width: 240px;
    }

    label {
      font-size: 0.95rem;
      font-weight: 600;
    }

    select,
    button {
      height: 42px;
      border-radius: 10px;
      border: 1px solid var(--border);
      padding: 0 12px;
      font: inherit;
    }

    select {
      background: var(--card);
      color: var(--text);
    }

    button {
      background: var(--accent);
      color: white;
      cursor: pointer;
      border: none;
      font-weight: 600;
    }

    button:hover {
      background: var(--accent-dark);
    }

    .summary {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 14px;
      margin-bottom: 20px;
    }

    .metric {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 14px;
      box-shadow: var(--shadow);
      padding: 16px;
    }

    .metric .label {
      color: var(--muted);
      font-size: 0.9rem;
      margin-bottom: 8px;
    }

    .metric .value {
      font-size: 1.5rem;
      font-weight: 700;
    }

    .table-wrap {
      overflow-x: auto;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      min-width: 760px;
    }

    th,
    td {
      padding: 12px 10px;
      border-bottom: 1px solid var(--border);
      text-align: left;
      vertical-align: top;
    }

    th {
      font-size: 0.9rem;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    td.num {
      text-align: right;
      font-variant-numeric: tabular-nums;
    }

    .income { color: var(--income); }
    .expense { color: var(--expense); }
    .net { color: var(--net); }

    .empty {
      color: var(--muted);
      padding: 16px 0 4px;
    }

    @media (max-width: 640px) {
      .page { padding: 16px; }
      .title-wrap h1 { font-size: 1.6rem; }
      .field { min-width: 100%; }
      button { width: 100%; }
    }
  </style>
</head>
<body>
  <div class="page">
    <div class="topbar">
      <div class="title-wrap">
        <h1>Monthly Cash-Flow by Property</h1>
        <p>Latest import ID: <%= latestImportId %></p>
      </div>
      <a href="/">&larr; Back to dashboard</a>
    </div>

    <div class="card">
      <form class="filters" method="get" action="/reports/cash-flow">
        <div class="field">
          <label for="property_name">Property</label>
          <select id="property_name" name="property_name">
            <option value="">All properties</option>
            <% properties.forEach(function(p) { %>
              <option value="<%= p.property_name %>" <%= propertyFilter === p.property_name ? 'selected' : '' %>>
                <%= p.property_name %>
              </option>
            <% }) %>
          </select>
        </div>
        <button type="submit">Apply filter</button>
      </form>
    </div>

    <%
      const totalMonths = rows.length;
      const totalTransactions = rows.reduce((sum, r) => sum + Number(r.txn_count || 0), 0);
      const totalIncome = rows.reduce((sum, r) => sum + Number(r.income_total || 0), 0);
      const totalExpenses = rows.reduce((sum, r) => sum + Number(r.expense_total || 0), 0);
      const totalNet = rows.reduce((sum, r) => sum + Number(r.net_total || 0), 0);
      const propertyCount = new Set(rows.map(r => r.property_name)).size;
      function money(v) {
        return Number(v || 0).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      }
    %>

    <div class="summary">
      <div class="metric">
        <div class="label">Properties</div>
        <div class="value"><%= propertyCount %></div>
      </div>
      <div class="metric">
        <div class="label">Property-month rows</div>
        <div class="value"><%= totalMonths %></div>
      </div>
      <div class="metric">
        <div class="label">Transactions</div>
        <div class="value"><%= totalTransactions %></div>
      </div>
      <div class="metric">
        <div class="label">Income</div>
        <div class="value income"><%= money(totalIncome) %></div>
      </div>
      <div class="metric">
        <div class="label">Expenses</div>
        <div class="value expense"><%= money(totalExpenses) %></div>
      </div>
      <div class="metric">
        <div class="label">Net</div>
        <div class="value net"><%= money(totalNet) %></div>
      </div>
    </div>

    <div class="card">
      <% if (!rows.length) { %>
        <div class="empty">No cash-flow rows found for the selected filter.</div>
      <% } else { %>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Property</th>
                <th>Month</th>
                <th>Transactions</th>
                <th>Income</th>
                <th>Expenses</th>
                <th>Net</th>
              </tr>
            </thead>
            <tbody>
              <% rows.forEach(function(r) { %>
                <tr>
                  <td><%= r.property_name %></td>
                  <td><%= r.month %></td>
                  <td class="num"><%= r.txn_count %></td>
                  <td class="num income"><%= money(r.income_total) %></td>
                  <td class="num expense"><%= money(r.expense_total) %></td>
                  <td class="num net"><%= money(r.net_total) %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</body>
</html>
